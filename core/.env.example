# core/.env.example — образец env-файла для core monolith.
# Скопируй в `core/.env` и заполни секреты живыми значениями.

# ============================================================================
# DATABASE (PostgreSQL + pgvector) — DatabaseSettings
# ============================================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=bestfiend
POSTGRES_USER=bestfiend
POSTGRES_PASSWORD=changeme
POSTGRES_POOL_MIN_SIZE=5
POSTGRES_POOL_MAX_SIZE=20
POSTGRES_AUTO_MIGRATE=true

# ============================================================================
# ARTIFACTS STORAGE (SeaweedFS / S3) — ArtifactSettings
# Dev: endpoint на localhost:8333 (docker compose seaweedfs). В compose-сети
# для core — http://seaweedfs:8333. Bucket создаётся автоматически на старте.
# ============================================================================
ARTIFACT_S3_ENDPOINT_URL=http://localhost:8333
ARTIFACT_S3_ACCESS_KEY=bestfiend
ARTIFACT_S3_SECRET_KEY=changeme
ARTIFACT_S3_BUCKET=artifacts
ARTIFACT_S3_REGION=us-east-1
ARTIFACT_MAX_PAYLOAD_SIZE_MB=25

# ============================================================================
# CORE HTTP SERVER
# ============================================================================
# CORE_PORT=8010

# ============================================================================
# PUBLIC URL (PublicUrlSettings) — как приложение видит браузер пользователя
# От него собираются OAuth redirect_uri ({url}/api/mcp/oauth/callback) и
# браузерные редиректы callback'а. Dev: vite 5173 проксирует /api в core.
# Тот же адрес должен быть прописан у OAuth-провайдера (Google Cloud Console).
# ============================================================================
# PUBLIC_BASE_URL=http://localhost:5173

# ============================================================================
# AUTH (AuthSettings)
# ============================================================================
AUTH_COOKIE_SECURE=false
# AUTH_BCRYPT_COST=12
# AUTH_BINDING_CODE_TTL_S=600
# AUTH_SESSION_TTL_S=2592000
# AUTH_COOKIE_NAME=bestfiend_session

# ============================================================================
# TELEGRAM (TelegramBotSettings)
# ============================================================================
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_ALLOWED_USER_IDS=
# Окно склейки бурста входящих (альбом, forward + комментарий).
# TELEGRAM_INBOX_DEBOUNCE_S=0.5

# ============================================================================
# MODEL ID (ModelIDSettings) — одна модель на весь граф
# ============================================================================
MODEL_ID=deepseek/deepseek-v4-flash

# ============================================================================
# GRAPH (GraphSettings) — нативная передача картинок
# ============================================================================
# VISION_MAX_HISTORY_IMAGES=6
# VISION_MAX_IMAGE_BYTES=5242880

# ============================================================================
# MCP DISCOVERY (McpDiscoverySettings)
# Таймаут опроса MCP-серверов (initialize + list_tools), per-server.
# Только discovery — НЕ таймаут исполнения call_tool (тот из конфига подключения).
# ============================================================================
MCP_DISCOVERY_TIMEOUT_S=10

# ============================================================================
# MEMORY (MemorySettings) — лог-центричная память
# Архитектура: docs/memory_architecture_alt.md. Модели — id из таблицы models
# (прямой lookup, без per-user resolve). Пустой id = слот сознательно выключен.
# ============================================================================
MEMORY_LLM_MODEL_ID=deepseek/deepseek-v4-flash-nothink
MEMORY_EMBEDDING_MODEL_ID=openrouter/qwen3-embedding-8b
MEMORY_EMBEDDING_DIM=1024

# Бюджеты контекста (токены)
LOG_TAIL_TOKEN_BUDGET=30000
JOURNAL_TOKEN_BUDGET=4000
RECALL_TOKEN_BUDGET=2000
# Потолок одной секции профиля; переполнение → демоция наименее используемых
PROFILE_SECTION_TOKEN_BUDGET=700

# Observer: порог необработанных токенов лога для фонового прогона
OBSERVER_TOKEN_THRESHOLD=6000
OBSERVER_MAX_TURNS=30

# Reconciler: сколько соседей по памяти видит LLM на каждого кандидата
RECONCILER_NEIGHBORS_K=5

# Recall: gate и размеры выборок
RECALL_MIN_SIMILARITY=0.5
RECALL_TOP_K=8
RECALL_CANDIDATES_PER_BRANCH=50

# Sleep-time: консолидация в простое (после N минут тишины)
SLEEP_IDLE_MINUTES=30
SLEEP_MAX_CARDS_PER_CYCLE=3
SLEEP_ENTITY_HOT_THRESHOLD=5
SLEEP_MAX_SUMMARIES_PER_CYCLE=1
SLEEP_SUMMARY_MIN_NOTES=5
SLEEP_MERGE_SIMILARITY=0.92
SLEEP_MAX_PROBES_PER_CYCLE=2

# memory_read_log: потолок ходов одного вызова
READ_LOG_MAX_TURNS=50

# ============================================================================
# STT (SttSettings) — транскрипция голосовых и аудио.
# Адрес OpenAI-совместимого сервера БЕЗ /v1 (self-hosted vLLM с ASR-моделью);
# путь эндпоинта дописывает адаптер. Пустой STT_URL = транскрипция выключена,
# бот отвечает на голосовые отказом.
# ============================================================================
STT_URL=
# STT_MODEL=Qwen/Qwen3-ASR-1.7B
# STT_TIMEOUT_S=60
# Гейт длительности: проверяется по метаданным до скачивания файла.
# STT_MAX_DURATION_S=300

# ============================================================================
# LANGFUSE (TracingSettings + DashboardSettings)
# ============================================================================
LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY=your-langfuse-public-key
LANGFUSE_SECRET_KEY=your-langfuse-secret-key
LANGFUSE_BASE_URL=http://langfuse.local:3000
LANGFUSE_FLUSH_INTERVAL=2

LANGFUSE_UI_URL=http://langfuse.local:3000
LANGFUSE_PROJECT_ID=

# ============================================================================
# DASHBOARD (DashboardSettings)
# ============================================================================
# DASHBOARD_HEALTH_TIMEOUT_S=2.0
# CORE_SELF_URL=http://127.0.0.1:8010
